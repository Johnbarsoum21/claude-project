# Copy to .env for local `expo start` usage, or (preferred for this cloud
# session) set these as environment variables in the project's environment
# settings panel, never by pasting them into chat.

# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Tink (https://console.tink.com) -- CLIENT ID is safe in the mobile client.
TINK_CLIENT_ID=
TINK_REDIRECT_URI=financialhub://tink-callback

# Backend base URL (Supabase Edge Functions host), used for the Tink
# OAuth code exchange which must happen server-side.
API_BASE_URL=

# --- Server-side only (Supabase Edge Function secrets, set via
# `supabase secrets set`, NEVER put these in this file or in the app) ---
# TINK_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
